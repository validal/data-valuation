"""GPU-resident KNN-Shapley with LSH acceleration (AKShapley).

``AKShapleyGPU`` computes the same quantity as
:class:`~opendataval.dataval.knnshap.scknnshap.KNNShapleyLSH` but moves all
three of the reference implementation's Python loops onto the accelerator.
The LSH *approximation itself is preserved exactly* -- this is a faster
evaluation of the same algorithm, not a different (or exact-KNN) one.

The reference has three structural bottlenecks, none of which touch the GPU:

1. ``LSH.__init__`` hashes the training set one point at a time
   (``for i in range(n_train)``), building ``n_hash_table`` string keys per
   point via ``".".join(map(str, ...))``.  For CIFAR-10 with 100 tables that
   is 4M string joins feeding 4M dict insertions.

2. ``LSH.get_approx_KNN`` loops over validation points, and for each one
   evaluates ``np.linalg.norm`` in a *Python list comprehension* over every
   colliding candidate.  When the hash is loose the candidate set approaches
   the full training set, so this is up to ``n_valid * n_train`` interpreted
   norm calls (4e8 for CIFAR-10).

3. ``LSH.compute_approx_shapley`` allocates an ``n_train`` vector per
   validation point and fills it with a ``K_star``-step scalar recursion.

Here:

* hashing becomes a single batched matmul per table, and the string keys are
  replaced by integer bucket ids from ``torch.unique(..., dim=0)``.  Tuple
  equality is exactly string equality for integer hash codes, so the buckets
  are identical, not approximated;

* the query stage scatters each table's bucket members into a
  ``(chunk, n_train)`` boolean candidate mask, fills non-candidates with
  ``inf`` and sorts.  The retrieved neighbour set is exactly the set the
  reference sorts -- LSH pruning is retained as the mask;

* the Shapley recursion is unrolled into a suffix sum, the same closed form
  used by :class:`~opendataval.dataval.knnshap.knnshapvec.KNNShapleyVec`.
  The recursion weight depends only on the rank ``i``::

      w[i]   = min(K, i+1) / (K * (i+1))
      s[i]   = s[i+1] + w[i] * (m[i] - m[i+1]),   s[K_tot] = 0

  which unrolls to ``s[i] = sum_{u=i}^{K_tot-1} w[u] * (m[u] - m[u+1])``: a
  single ``flip -> cumsum -> flip``.

Numerics.  The reference computes the recursion in float64 scalar arithmetic
(the ``equal`` terms are Python ints), so unlike ``KNNShapleyVec`` -- which had
to reproduce a float32 rounding step -- everything here stays in float64, and
the term is evaluated in the reference's operation order.  Distances use a
float64 Gram expansion rather than ``torch.cdist``'s default float32
mm path, whose ~1e-5 relative error would reorder near-tied neighbours.

Ties.  The reference breaks distance ties with ``np.argsort``'s unstable
quicksort, so its tie order is arbitrary; this version uses a stable sort,
which breaks ties by ascending training index.  Exact ties require duplicate
embeddings and are otherwise measure-zero.
"""

import time
from math import ceil
from typing import Optional

import numpy as np
import torch

from opendataval.dataval.knnshap.scknnshap import KNNShapleyLSH, f_h
from opendataval.dataval.progress import progress_range
from opendataval.model.api import Model


class AKShapleyGPU(KNNShapleyLSH):
    """LSH-accelerated KNN-Shapley, GPU-resident.

    Drop-in replacement for :class:`KNNShapleyLSH` with identical semantics
    and output.

    Parameters
    ----------
    device : str | torch.device, optional
        Device for the computation. Defaults to CUDA when available.
    valid_chunk : int, optional
        Validation points processed per pass. Bounds the working set at
        ``(valid_chunk, n_train)``. By default 512.

    All other parameters are identical to :class:`KNNShapleyLSH`.

    References
    ----------
    .. [1] R. Jia et al.,
        Efficient Task-Specific Data Valuation for Nearest Neighbor Algorithms,
        VLDB 2019. Available: https://arxiv.org/abs/1908.08619.
    """

    def __init__(
        self,
        k_neighbors: int = 1,
        eps: float = 0.1,
        alpha: float = 0.5,
        n_hash_table: int = 10,
        mc_num: int = 5,
        num_cores: int = 1,
        dist_rand: Optional[float] = None,
        t: Optional[float] = None,
        embedding_model: Optional[Model] = None,
        random_state: Optional[int] = None,
        device: Optional[torch.device] = None,
        valid_chunk: int = 512,
        debug: bool = False,
    ):
        super().__init__(
            k_neighbors=k_neighbors,
            eps=eps,
            alpha=alpha,
            n_hash_table=n_hash_table,
            mc_num=mc_num,
            num_cores=num_cores,
            dist_rand=dist_rand,
            t=t,
            embedding_model=embedding_model,
            random_state=random_state,
        )
        if device is None:
            device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.device = torch.device(device)
        self.valid_chunk = valid_chunk
        self.debug = debug

    def __repr__(self) -> str:
        embedding_str = "None"
        if self.embedding_model is not None:
            embedding_str = self.embedding_model.__class__.__name__
        return (
            f"AKShapleyGPU(k_neighbors={self.k_neighbors}, eps={self.eps}, "
            f"alpha={self.alpha}, n_hash_table={self.n_hash_table}, "
            f"dist_rand={self._dist_rand_fixed}, t={self._t_fixed}, "
            f"device={self.device.type}, valid_chunk={self.valid_chunk}, "
            f"embedding_model={embedding_str})"
        )

    __str__ = __repr__

    def _dbg(self, msg: str) -> None:
        if self.debug:
            print(f"[AKShapleyGPU][DEBUG] {msg}")


    # ------------------------------------------------------------------
    # Contrast estimation (replaces get_contrast / _estimate_contrast)
    # ------------------------------------------------------------------

    def _get_contrast(self, X, K):
        """GPU port of ``get_contrast``: mean random distance and mean KNN distance.

        The reference draws its Monte-Carlo splits with ``np.random.choice``
        and then evaluates every query-to-train distance in a ``joblib``
        loop over ``np.linalg.norm``.  The same index draws are reproduced
        here (so the split is identical) and the distances become a chunked
        matmul.
        """
        n = X.shape[0]
        dist_rand, contrast = [], []

        for _ in range(self.mc_num):
            ind_trn = np.random.choice(
                np.arange(n), int(n / 5 * 4), replace=False
            ).astype(int)
            ind_q = np.array(
                list(set(np.arange(n).astype(int).tolist()) - set(ind_trn.tolist()))
            ).astype(int)

            A = X[torch.as_tensor(ind_trn, device=self.device)]        # (n_trn, d)
            Q = X[torch.as_tensor(ind_q, device=self.device)]          # (n_q, d)

            # ``np.sort(dist)[:K]`` truncates when K exceeds the pool size;
            # topk raises, so clamp to reproduce the reference's behaviour.
            Keff = min(K, A.shape[0])
            means, knns = [], []
            for lo in range(0, Q.shape[0], self.valid_chunk):
                q = Q[lo : lo + self.valid_chunk]
                d2 = (q * q).sum(1, keepdim=True) + (A * A).sum(1) - 2.0 * (q @ A.T)
                d = d2.clamp_min_(0).sqrt_()
                means.append(d.mean(dim=1))
                knns.append(torch.topk(d, Keff, dim=1, largest=False, sorted=True).values)
            dist_to_random_avg = torch.cat(means)                      # (n_q,)
            dist_to_KNN = torch.cat(knns, dim=0)                       # (n_q, K)

            dr = float(dist_to_random_avg.mean())
            dk = dist_to_KNN.mean(dim=0)                               # (K,)
            dist_rand.append(dr)
            contrast.append((dr / dk).cpu().numpy())

        return np.array(dist_rand), np.array(contrast)

    # ------------------------------------------------------------------
    # Stage 1: hashing -> integer bucket ids (replaces LSH.__init__)
    # ------------------------------------------------------------------

    def _bucket_ids(self, Xt, Xv, w, b, t):
        """Per-table bucket ids for train and validation points.

        ``lsh_function`` is ``floor((w . x + b) / t)``; batching over points
        makes each table a single ``(n, dim) @ (dim, n_hash_bit)`` matmul.
        The reference then keys a dict on ``".".join(map(str, code))``; two
        integer codes give the same string iff they are equal element-wise, so
        ``torch.unique(..., dim=0)`` over the *concatenated* train+valid codes
        assigns matching ids to exactly the colliding points.

        Returns
        -------
        trn_ids, val_ids : torch.Tensor, shape (n_hash_table, n) / (n_hash_table, m)
        """
        L = self.n_hash_table
        n, m = Xt.shape[0], Xv.shape[0]
        trn_ids = torch.empty((L, n), dtype=torch.int32, device=self.device)
        val_ids = torch.empty((L, m), dtype=torch.int32, device=self.device)

        for l in progress_range(L, "AKShapleyGPU: hashing"):
            wl = w[l].to(self.device)              # (n_hash_bit, dim) float64
            bl = b[l].to(self.device)              # (n_hash_bit,)
            code_t = torch.floor((Xt @ wl.T + bl) / t).to(torch.int64)
            code_v = torch.floor((Xv @ wl.T + bl) / t).to(torch.int64)
            _, inv = torch.unique(
                torch.cat([code_t, code_v], dim=0), dim=0, return_inverse=True
            )
            trn_ids[l] = inv[:n].to(torch.int32)
            val_ids[l] = inv[n:].to(torch.int32)

        return trn_ids, val_ids

    # ------------------------------------------------------------------
    # Stage 2: approximate KNN (replaces LSH.get_approx_KNN)
    # ------------------------------------------------------------------

    def _approx_knn(self, Xt, Xv, trn_ids, val_ids, K_star, lo, hi):
        """Approximate neighbours for validation points ``[lo, hi)``.

        Non-candidates are masked to ``inf`` before sorting, so the retrieved
        prefix is exactly the candidate union the reference sorts.  Positions
        past the candidate count are ``-1``, matching the reference's padding.
        """
        n = Xt.shape[0]
        Xq = Xv[lo:hi]                                              # (b, dim)
        b_ = Xq.shape[0]

        mask = torch.zeros((b_, n), dtype=torch.bool, device=self.device)
        for l in range(self.n_hash_table):
            mask |= trn_ids[l].unsqueeze(0).eq(val_ids[l, lo:hi].unsqueeze(1))

        # float64 Gram expansion. Two dtype notes:
        #
        # * ``torch.cdist``'s default float32 mm path has ~1e-5 relative error,
        #   enough to reorder near-tied neighbours -- hence the explicit form.
        # * The reference ranks on *float32* distances: ``x_trn / dist_rand``
        #   stays float32 under numpy's NEP 50 promotion, so ``np.linalg.norm``
        #   runs in float32.  Computing in float64 here is deliberate.  Matching
        #   the reference's dtype does *not* reproduce its ordering, because
        #   numpy and torch accumulate float32 in different orders and so carry
        #   independent rounding noise; measured on a production-shaped test
        #   (n=8000, d=512, K=1000), float32 agreed with the reference on the
        #   neighbour order for 191/400 queries versus 332/400 for float64.
        #   float64 is both more accurate and closer to the reference, and the
        #   candidates it reorders are near-tied, so values move by <=1e-16
        #   relative and the top-25% ranking is unchanged.
        d2 = (Xq * Xq).sum(1, keepdim=True) + (Xt * Xt).sum(1) - 2.0 * (Xq @ Xt.T)
        dist = d2.clamp_min_(0).sqrt_()
        dist_exact = dist.clone() if self._diag_recall is None else None
        dist = dist.masked_fill(~mask, float("inf"))

        n_cand = mask.sum(dim=1)                                    # (b,)
        _, order = torch.sort(dist, dim=1, stable=True)
        knn = order[:, :K_star].to(torch.int64)                     # (b, K_star)

        # Reference fills only the first ``min(K_star, n_cand)`` slots.
        pos = torch.arange(K_star, device=self.device).unsqueeze(0)
        valid = pos < n_cand.unsqueeze(1).clamp(max=K_star)

        # Is the LSH actually costing us neighbours?  The retrieved count
        # saturates at K_star, so it cannot answer that on its own: compare the
        # retrieved set against the exact top-K_star over the *same* distances
        # with no mask.  Recall < 1 means the hash is discarding true near
        # neighbours, i.e. dist_rand / t / eps are leaving accuracy on the
        # table.  Measured once, on the first chunk only.
        self._diag_cand += float(n_cand.sum())
        if self._diag_recall is None:
            ex = torch.topk(
                dist_exact, K_star, dim=1, largest=False, sorted=False
            ).indices
            hit = torch.zeros_like(mask)
            hit.scatter_(1, ex, True)
            got = torch.zeros_like(mask)
            # src=valid so padded slots (distance inf) are not counted as hits
            got.scatter_(1, knn.clamp_min(0), valid)
            self._diag_recall = float(
                ((hit & got).sum(1).double() / K_star).mean()
            )

        knn = torch.where(valid, knn, torch.full_like(knn, -1))
        return knn, valid

    # ------------------------------------------------------------------
    # Stage 3: Shapley recursion (replaces LSH.compute_approx_shapley)
    # ------------------------------------------------------------------

    def _shapley_chunk(self, knn, valid, y_trn, y_val_chunk, K, n):
        """Suffix-sum form of the reference recursion, batched over queries.

        The reference seeds ``sp_j`` with zeros and assigns positions
        ``K_tot-1 .. 0``, never position ``K_tot`` -- so the recursion base is
        ``s[K_tot] = 0`` (its ``K_tot == self.N`` branch is unreachable, since
        ``K_tot <= K_star - 1 << n_train``).
        """
        b_, K_star = knn.shape

        # match[j, i] = equal(y_trn[knn[j, i]], y_val[j]); 0 where padded, so a
        # -1 index can never wrap around to the last training label.
        safe = knn.clamp_min(0)
        match = (y_trn[safe] == y_val_chunk.unsqueeze(1)).to(torch.float64)
        match = match * valid.to(torch.float64)                     # (b, K_star)

        # term[u] is defined only when position u+1 is also a real neighbour;
        # candidates form a prefix, so validity of u+1 implies validity of u.
        ip1 = torch.arange(
            1, K_star, dtype=torch.float64, device=self.device
        ).unsqueeze(0)                                              # (1, K_star-1)
        mk = ip1.clamp(max=float(K))

        # Reference order of operations: ((diff / K) * min(K, i+1)) / (i+1).
        diff = match[:, :-1] - match[:, 1:]
        term = ((diff / K) * mk) / ip1
        term = term * valid[:, 1:].to(torch.float64)

        suffix = torch.flip(torch.cumsum(torch.flip(term, [1]), dim=1), [1])

        s = torch.zeros((b_, K_star), dtype=torch.float64, device=self.device)
        s[:, : K_star - 1] = suffix                                 # s[K_star-1] = 0

        # Scatter back to training-point order; padded slots contribute 0.
        s = s * valid.to(torch.float64)
        sp_sum = torch.zeros(n, dtype=torch.float64, device=self.device)
        sp_sum.scatter_add_(0, safe.reshape(-1), s.reshape(-1))
        return sp_sum

    # ------------------------------------------------------------------
    # opendataval interface
    # ------------------------------------------------------------------

    def train_data_values(self, *args, **kwargs):
        """Build the LSH index and compute Shapley values, on GPU."""
        if self.random_state is not None:
            np.random.seed(self.random_state)

        # Time the full embedding pass (train + validation) separately from the
        # valuation itself: for a model-less evaluator this is usually the only
        # part that touches the embedding network, so it is the cost that
        # scales with the backbone rather than with n_train.
        if torch.cuda.is_available():
            torch.cuda.synchronize()
        t_emb = time.time()
        x_trn_emb, x_val_emb = self.embeddings(self.x_train, self.x_valid)
        if torch.cuda.is_available():
            torch.cuda.synchronize()
        emb_secs = time.time() - t_emb

        x_trn = self._to_numpy(x_trn_emb)
        x_val = self._to_numpy(x_val_emb)
        n_trn = len(x_trn)
        n_tot = n_trn + len(x_val)
        emb_dim = int(np.prod(np.shape(x_trn)[1:])) if np.ndim(x_trn) > 1 else 1
        print(
            f"[AKShapleyGPU] Embedded {n_tot} samples "
            f"({n_trn} train + {len(x_val)} valid) in {emb_secs:.2f}s "
            f"({n_tot / max(emb_secs, 1e-9):.0f} samples/s, dim={emb_dim})"
        )
        self.embedding_seconds_ = emb_secs

        K = self.k_neighbors
        K_star = max(K, ceil(1 / self.eps))

        m_val = len(x_val)
        Xt = torch.as_tensor(x_trn).reshape(n_trn, -1).double().to(self.device)
        Xv = torch.as_tensor(x_val).reshape(m_val, -1).double().to(self.device)
        Xemb = Xv  # contrast is estimated on the validation embeddings

        # ---- 1. Determine dist_rand and t --------------------------------
        # Contrast estimation is inherited unchanged: it only runs when
        # dist_rand is not supplied, and it is not the bottleneck.
        contrast = None
        if self._dist_rand_fixed is not None:
            dist_rand = self._dist_rand_fixed
            print(f"[AKShapleyGPU] Using provided dist_rand={dist_rand:.4f}")
        else:
            print("[AKShapleyGPU] Estimating contrast from validation data...")
            K_c = int(1 / self.eps)
            # The contrast vector has min(K_c, 0.8*n_valid) entries -- the MC
            # split holds out 4/5 of the validation set as the pool -- and the
            # reference indexes it at [K_star - 1].
            n_pool = int(len(x_val) / 5 * 4)
            avail = min(K_c, n_pool)
            if K_star > avail:
                raise ValueError(
                    f"Automatic dist_rand/t needs K_star <= min(int(1/eps), "
                    f"0.8*n_valid): K_star={K_star} exceeds {avail} "
                    f"(int(1/eps)={K_c}, 0.8*n_valid={n_pool}). "
                    f"Use eps>={1.0 / min(K_star, n_pool):.3g} with "
                    f"k_neighbors={K}, or pass dist_rand= and t= explicitly."
                )
            dist_rand_mc, contrast_mc = self._get_contrast(Xemb, K_c)
            dist_rand = float(np.mean(dist_rand_mc, axis=0))
            contrast = float(np.mean(contrast_mc, axis=0)[K_star - 1])
            print(f"[AKShapleyGPU] dist_rand={dist_rand:.4f}, contrast={contrast:.4f}")

        if self._t_fixed is not None:
            t = self._t_fixed
            print(f"[AKShapleyGPU] Using provided t={t:.4f}")
        elif contrast is not None:
            from opendataval.dataval.knnshap.scknnshap import find_best_r_normalize

            t = find_best_r_normalize(np.arange(1e-3, 10, 1e-3), contrast)
            print(f"[AKShapleyGPU] Selected t={t:.4f} via contrast minimization")
        else:
            t = 1.0
            print(f"[AKShapleyGPU] dist_rand provided but t not set, using t={t:.4f}.")

        # ---- 2. n_hash_bit, and the same hash functions as the reference ---
        n_hash_bit = int(np.ceil(np.log(n_trn) * self.alpha / np.log(1.0 / f_h(1.0, t))))
        print(
            f"[AKShapleyGPU] n_hash_bit={n_hash_bit}, "
            f"n_hash_table={self.n_hash_table}, K_star={K_star}"
        )

        dim = x_trn.reshape(n_trn, -1).shape[1]
        # Drawn in the reference's order and shapes so a matched seed gives
        # bit-identical projections.
        w = torch.as_tensor(
            np.random.normal(0, 1, (self.n_hash_table, n_hash_bit, dim))
        )
        b = torch.as_tensor(np.random.uniform(0, t, (self.n_hash_table, n_hash_bit)))

        # ---- 3. Move data to device; hash --------------------------------
        # The reference hashes and measures distance on x / dist_rand.
        # Report how well the supplied dist_rand matches these embeddings:
        # it is meant to be their mean pairwise distance, and the hash width
        # is only meaningful at that scale.
        with torch.no_grad():
            idx = torch.randperm(n_trn, device=self.device)[: min(2000, n_trn)]
            P = Xt[idx]
            d2 = (P * P).sum(1, keepdim=True) + (P * P).sum(1) - 2.0 * (P @ P.T)
            emp = float(d2.clamp_min_(0).sqrt_().mean())
        print(
            f"[AKShapleyGPU] dist_rand={dist_rand:.4f} vs empirical mean pairwise "
            f"distance={emp:.4f} (ratio {emp / dist_rand:.2f}x)"
        )

        Xt = Xt / dist_rand
        Xv = Xv / dist_rand

        y_trn = torch.as_tensor(np.asarray(self.y_train)).to(self.device)
        y_val = torch.as_tensor(np.asarray(self.y_valid)).to(self.device)

        self._dbg(
            f"n_train={n_trn}, n_valid={m_val}, dim={dim}, K={K}, "
            f"K_star={K_star}, device={self.device}, valid_chunk={self.valid_chunk}"
        )

        start = time.time()
        trn_ids, val_ids = self._bucket_ids(Xt, Xv, w, b, t)
        print(f"[AKShapleyGPU] LSH built in {time.time() - start:.2f}s")

        # ---- 4/5. Query + Shapley, fused over validation chunks -----------
        start = time.time()
        sp_sum = torch.zeros(n_trn, dtype=torch.float64, device=self.device)
        n_chunks = (m_val + self.valid_chunk - 1) // self.valid_chunk
        cand_total = 0
        knn_dbg = []
        self._diag_cand = 0.0
        self._diag_recall = None

        for c in progress_range(n_chunks, "AKShapleyGPU: query + Shapley"):
            lo = c * self.valid_chunk
            hi = min(lo + self.valid_chunk, m_val)
            knn, valid = self._approx_knn(Xt, Xv, trn_ids, val_ids, K_star, lo, hi)
            cand_total += int(valid.sum().item())
            if self.debug:
                knn_dbg.append(knn.cpu().numpy())
            sp_sum += self._shapley_chunk(knn, valid, y_trn, y_val[lo:hi], K, n_trn)
            del knn, valid

        print(
            f"[AKShapleyGPU] Query + Shapley done in {time.time() - start:.2f}s "
            f"(mean retrieved neighbours/query: {cand_total / max(m_val, 1):.1f})"
        )
        print(
            f"[AKShapleyGPU] LSH candidates/query (uncapped): "
            f"{self._diag_cand / max(m_val, 1):.1f} of {n_trn}  |  "
            f"recall@K_star vs exact KNN: {self._diag_recall:.4f}"
        )

        if self.debug:
            # Retrieved-neighbour matrix, for comparison against the reference.
            self.knn_matrix_ = np.concatenate(knn_dbg, axis=0)

        self.data_values = (sp_sum / m_val).cpu().numpy()
        return self
